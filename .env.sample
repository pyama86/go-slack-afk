SLACK_BOT_TOKEN=xoxb-your-token
SLACK_APP_TOKEN=xapp-your-token

# Store Configuration
# redis or dynamodb (default: redis)
STORE_TYPE=redis
REDIS_URL=redis://localhost:6379

# DynamoDB Configuration (when STORE_TYPE=dynamodb)
# DYNAMO_LOCAL=1
# DYNAMO_ENDPOINT=http://localhost:8000
# DYNAMO_TABLE_PREFIX=slack_afk
# DYNAMO_KV_TABLE_NAME=slack_afk_kv
# DYNAMO_LIST_TABLE_NAME=slack_afk_list
# DYNAMO_PRESENCE_TABLE_NAME=slack_afk_presence

# Optional
# AFK_START_MESSAGE=おはようございます、今日も自分史上最高の日にしましょう!!1
# AFK_FINISH_MESSAGE=お疲れさまでした!!1
